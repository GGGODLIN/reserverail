{
  "name": "reserverail",
  "version": "0.1.0",
  "private": true,
  "description": "Verifiable multi-agent treasury spend rail backed by Circom 2.x Groth16 state-transition proofs on zkVerify Mainnet via Kurier",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.1.0"
  },
  "scripts": {
    "start": "npm run build:web && node --experimental-strip-types src/server/start.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "build:circuit": "node --experimental-strip-types scripts/build-circuit.ts",
    "probe:kurier": "node --experimental-strip-types scripts/kurier-live-probe.ts",
    "diag": "node --experimental-strip-types scripts/diag.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "npm run build:web && E2E_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 e2e run --target replay --output .e2e/replay tests/e2e/replay && E2E_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 e2e run --target live-sim --output .e2e/live-sim tests/e2e/live-sim"
  },
  "dependencies": {
    "@zk-kit/circuits": "0.4.0",
    "@zk-kit/imt": "2.0.0-beta.8",
    "circomlib": "^2.0.5",
    "poseidon-lite": "^0.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "snarkjs": "^0.7.6",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@e2e-dev/web": "0.11.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^6.3.0",
    "e2e": "0.16.0",
    "fast-check": "^3.23.2",
    "playwright": "1.63.0",
    "typescript": "^5.8.2",
    "vite": "^8.3.7"
  }
}
