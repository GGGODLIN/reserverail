[Unit]
Description=ReserveRail Verifiable Multi-Agent Treasury Rail
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/reserverail
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3410
Environment=RESERVERAIL_DB_PATH=/var/lib/reserverail/reserverail.db
EnvironmentFile=/etc/reserverail/reserverail.env
ExecStart=/usr/bin/node --experimental-strip-types src/server/start.ts
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/reserverail

[Install]
WantedBy=multi-user.target
